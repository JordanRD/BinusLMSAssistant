# Chrome User Data Configuration
# CHROME_USER_DATA_DIR: Path to store persistent browser profile (cookies, logins, cache)
# Use relative path (e.g., ./.chrome_user_data) or absolute path
CHROME_USER_DATA_DIR=./.chrome_user_data

# CHROME_PROFILE_DIR: Specific profile folder inside the user-data directory
CHROME_PROFILE_DIR=Default

# Set to true if you want to run Chrome in headless mode (without visible UI)
HEADLESS=false
